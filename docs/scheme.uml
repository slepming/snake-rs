@startuml
left to right direction
skinparam defaultFontName "Fira Code"
skinparam monochrome false
skinparam packageStyle rect
skinparam shadowing false

!define ORANGE #DE6733
!define DARK #282C34
!define LIGHT #F2EFEA
!define BROWN #523024

skinparam struct {
    BackgroundColor LIGHT
    ArrowColor BROWN
    BorderColor BROWN
    HeaderBackgroundColor ORANGE
    HeaderFontColor White
    FontColor BROWN
    AttributeFontName "Consolas"
    AttributeFontSize 11
}

skinparam enum {
    BackgroundColor LIGHT
    ArrowColor BROWN
    BorderColor BROWN
    HeaderBackgroundColor ORANGE
    HeaderFontColor White
    FontColor BROWN
    AttributeFontName "Consolas"
    AttributeFontSize 11
}

skinparam interface {
    BackgroundColor White
    BorderColor ORANGE
    FontColor BROWN
}

skinparam note {
    BackgroundColor #FEF9E7
    BorderColor ORANGE
}

skinparam package {
    BorderColor BROWN
    FontColor BROWN
}

title Архитектура engine

package "engine" {
    struct "EngineContext<Redraw, Start>" as EngineContext {
        - instance: Arc<Instance>
        - device: Arc<Device>
        - queue: Arc<Queue>
        - memory: Arc<EngineMemory>
        - pipelines: Arc<PipelineCache>
        - descriptors: Arc<DescriptorSetCache>
        - sampler: Arc<Sampler>
        - rcx: Option<RenderContext>
        - game: GameContext
        - debug: DebugUtils
        - redraw: Redraw
        - start: Start
        + new(event_loop: &EventLoop<()>, start: Start, redraw: Redraw) -> EngineContext
    }

    struct GameContext {
        + children: Children
        + assets: AssetsManager
        + frames: u64
        + game_command_queue: CommandQueue
    }

    struct RenderContext {
        - window: Arc<Window>
        - swapchain: Arc<Swapchain>
        - render_pass: Arc<RenderPass>
        - framebuffers: Vec<Arc<Framebuffer>>
        - viewport: Viewport
        - recreate_swapchain: bool
        - previous_frame_end: Option<Box<dyn GpuFuture>>
        - scale: Vec2
    }

    struct MyVertex {
        + position: [f32; 2]
    }
    
    interface ApplicationHandler << (T,ORANGE) >> {
        + resumed(&mut self, event_loop: &ActiveEventLoop)
        + window_event(&mut self, event_loop: &ActiveEventLoop, id: WindowId, event: WindowEvent)
        + about_to_wait(&mut self, event_loop: &ActiveEventLoop)
    }
}

package "Commands" {
    struct CommandQueue {
        - commands: VecDeque<DrawCommand>
        + append(&mut self, command: DrawCommand)
    }

    enum DrawCommand {
        DrawObject(Shapes, DrawableCreateInfo)
        ClearDrawables
    }

    interface CommandDispatcher << (T,ORANGE) >> {
        + flush_commands(&mut self)
    }
}

package "Memory" {
    struct EngineMemory {
        + command_buffer_allocator: Arc<StandardCommandBufferAllocator>
        + memory_allocator: Arc<StandardMemoryAllocator>
        + descriptor_allocator: Arc<StandardDescriptorSetAllocator>
        + new(device: Arc<Device>) -> EngineMemory
    }
}

package "Resources" {
    struct AssetsManager {
        ~ queue: Arc<Queue>
        ~ memory_allocs: Arc<EngineMemory>
        ~ texture_pool: RwLock<HashMap<String, Arc<TextureHandler>>>
        + load(&self, file_name: &Path, internal: bool) -> Arc<TextureHandler>
    }

    struct TextureHandler {
        ~ view: Arc<ImageView>
    }

    interface "CacheProvider<A>" as CacheProvider << (T,ORANGE) >> {
        + get(&self, key: &str) -> Option<A>
        + insert(&self, value: (String, A)) -> Option<A>
        + len(&self) -> usize
    }
    
    struct PipelineCache {
        - pipelines: RwLock<HashMap<String, Arc<GraphicsPipeline>>>
        + new(pipelines: HashMap<String, Arc<GraphicsPipeline>>) -> PipelineCache
    }

    struct DescriptorSetCache {
        - descriptors: RwLock<HashMap<String, Arc<DescriptorSet>>>
        + new(descriptors: HashMap<String, Arc<DescriptorSet>>) -> DescriptorSetCache
    }
}

package "Movement" {
    interface Position << (T,ORANGE) >> {
        + get_matrix_mut(&mut self) -> &mut [[f32; 4]; 4]
        + get_matrix(&self) -> &[[f32; 4]; 4]
    }
}

package "Drawing" {
    struct Children {
        - drawables: Vec<Drawable>
        + new() -> Children
        + add(&mut self, item: Drawable)
        + get(&self, index: usize) -> Option<&Drawable>
        + iter(&self) -> Iter<'_, Drawable>
        + len(&self) -> usize
        + clear(&mut self)
    }

    struct Drawable {
        - transform: Transform
        - color: Rgba8
        ~ render: DrawableRenderContext
        + new(...) -> Drawable
        + from_shape(...) -> (Drawable, Option<Arc<DescriptorSet>>)
    }

    struct DrawableRenderContext {
        ~ descriptor_id: DescriptorID
        - pipeline_id: PipelineID
        - mesh: Mesh
    }

    struct PipelineID {
        + id: String
    }

    struct DescriptorID {
        + id: String
    }

    struct Mesh {
        - vertex: Vec<MyVertex>
        - id: u32
        + new(...) -> Mesh
        + get_id(&self) -> &u32
    }
    
    struct DrawableCreateInfo {
        + position: Vec2
        + texture: Option<Texture>
        + radius: f32
        + thickness: f32
        + size: Vec2
        + id: u32
        + color: Rgba8
    }

    struct Texture {
        ~ image: Vec<u8>
        + dimensions: (u32, u32)
        + from_file(path: &str) -> Option<Texture>
        + from_internal_assets(filename: &str) -> Option<Texture>
    }

    interface DrawableGPU << (T,ORANGE) >> {
        + set_vertex(&mut self, vertex: Vec<MyVertex>)
        + get_vertex_clone(&self) -> Vec<MyVertex>
        + get_vertex(&self) -> &Vec<MyVertex>
        + get_colour(&self) -> &Rgba8
    }

    interface DrawableComponent << (T,ORANGE) >> {
        + get_transform(&self) -> &Transform
        + get_transform_clone(&self) -> Transform
        + set_transform(&mut self, transform: Transform)
        + drawable(&self) -> &Drawable
        + drawable_mut(&mut self) -> &mut Drawable
    }
}

package "Geometry" {
    struct Transform {
        + transform: [[f32; 4]; 4]
    }

    enum Shapes {
        Square
        Circle
        Image(Arc<TextureHandler>)
        + get_vertex_and_descriptor(...) -> (Vec<MyVertex>, Option<Arc<DescriptorSet>>)
    }
}

' Relationships
ApplicationHandler <|.. EngineContext : implement
CommandDispatcher <|.. EngineContext : implement

CacheProvider <|.. PipelineCache : implement
CacheProvider <|.. DescriptorSetCache : implement

EngineContext o-- RenderContext : contains (Option)
EngineContext *-- GameContext : own
EngineContext *-- EngineMemory : own
EngineContext *-- PipelineCache : own
EngineContext *-- DescriptorSetCache : own

GameContext *-- Children : own
GameContext *-- AssetsManager : own
GameContext *-- CommandQueue : own

CommandQueue o-- DrawCommand : contains

DrawableGPU <|-- DrawableComponent : extend
DrawableComponent <|.. Drawable : implement
DrawableGPU <|.. Drawable : implement

Position <|.. Transform : implement

Children o-- Drawable : contains

Drawable *-- Transform : own
Drawable *-- DrawableRenderContext : own
DrawableRenderContext *-- Mesh : own
DrawableRenderContext *-- PipelineID : own
DrawableRenderContext *-- DescriptorID : own
Mesh *-- MyVertex : own

Shapes o-- TextureHandler : contains

note right of EngineContext
    Центральная точка входа.
    Управляет жизненным циклом
    приложения через ApplicationHandler и CommandDispatcher.
    Настраивается через замыкания
    (Start и Redraw).
end note

@enduml
