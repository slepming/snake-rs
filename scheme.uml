@startuml
left to right direction
skinparam defaultFontName "Fira Code"
skinparam monochrome false
skinparam packageStyle rect
skinparam shadowing false

!define ORANGE #DE6733
!define DARK #282C34
!define LIGHT #F2EFEA
!define BROWN #523024

skinparam struct {
    BackgroundColor LIGHT
    ArrowColor BROWN
    BorderColor BROWN
    HeaderBackgroundColor ORANGE
    HeaderFontColor White
    FontColor BROWN
    AttributeFontName "Consolas"
    AttributeFontSize 11
}

skinparam enum {
    BackgroundColor LIGHT
    ArrowColor BROWN
    BorderColor BROWN
    HeaderBackgroundColor ORANGE
    HeaderFontColor White
    FontColor BROWN
    AttributeFontName "Consolas"
    AttributeFontSize 11
}

skinparam interface {
    BackgroundColor White
    BorderColor ORANGE
    FontColor BROWN
}

skinparam note {
    BackgroundColor #FEF9E7
    BorderColor ORANGE
}

skinparam package {
    BorderColor BROWN
    FontColor BROWN
}

title Архитектура

package "Base" {
    package "Winit / Event Loop" {
        interface ApplicationHandler << (T,ORANGE) >> {
            + resumed(&mut self, event_loop: &ActiveEventLoop)
            + window_event(&mut self, event_loop: &ActiveEventLoop, id: WindowId, event: WindowEvent)
            + about_to_wait(&mut self, event_loop: &ActiveEventLoop)
        }
    }

    package "Core Engine" {
        struct "EngineContext<Drw, Redraw, Start>" as EngineContext {
            - instance: Arc<Instance>
            - device: Arc<Device>
            - queue: Arc<Queue>
            - memory: EngineMemory
            - rcx: Option<RenderContext>
            - cache: Arc<Cache>
            + physics_context: PhysicsContext
            + children: Children<Drw>
            + frames: u64
            - redraw: Redraw
            - start: Start
            + new(event_loop: &EventLoop<()>, start: Start, redraw: Redraw) -> EngineContext
            + calculate_drawables(...) -> (Subbuffer<[MyVertex]>, Vec<Transform>, Vec<u32>)
        }

        struct EngineMemory {
            + command_buffer_allocator: Arc<StandardCommandBufferAllocator>
            + memory_allocator: Arc<StandardMemoryAllocator>
            + descriptor_allocator: Arc<StandardDescriptorSetAllocator>
            + new(device: Arc<Device>) -> EngineMemory
        }

        struct Cache {
            - pipelines: RwLock<HashMap<&'static str, Arc<GraphicsPipeline>>>
            - descriptors: RwLock<HashMap<String, Arc<DescriptorSet>>>
            + memory_allocator: Option<Arc<StandardMemoryAllocator>>
            + descriptor_allocator: Option<Arc<StandardDescriptorSetAllocator>>
            ~ sampler: Arc<Sampler>
            + new(...) -> Cache
        }

        interface PipelineHandle << (T,ORANGE) >> {
            + get_pipeline(&self, key: &str) -> Option<Arc<GraphicsPipeline>>
            + insert_pipeline(&self, key: &'static str, pipeline: Arc<GraphicsPipeline>) -> &Self
        }

        interface DescriptorHandle << (T,ORANGE) >> {
            + get_descriptor(&self, key: &str) -> Option<Arc<DescriptorSet>>
            + insert_descriptor_set(&self, key: String, descriptor_set: Arc<DescriptorSet>) -> &Self
        }
    }
}

package "Vulkan Rendering" {
    struct RenderContext {
        - window: Arc<Window>
        - swapchain: Arc<Swapchain>
        - render_pass: Arc<RenderPass>
        - framebuffers: Vec<Arc<Framebuffer>>
        - viewport: Viewport
        - recreate_swapchain: bool
        - previous_frame_end: Option<Box<dyn GpuFuture>>
        - scale: Vec2
    }

    struct MyVertex {
        + position: [f32; 2]
    }
}

package "Physics (Rapier2D)" {
    struct PhysicsContext {
        + rigid_body_set: RigidBodySet
        + collider_set: ColliderSet
        + space: PhysicsSpace
        + new(...) -> PhysicsContext
        + step(&mut self)
        + create_phys_square(...) -> PhysicsDrawable
    }

    struct PhysicsSpace {
        - integration_parameters: IntegrationParameters
        - pipeline: PhysicsPipeline
        - island_manager: IslandManager
        - broad_phase: DefaultBroadPhase
        - narrow_phase: NarrowPhase
        - impulse_joint_set: ImpulseJointSet
        - multibody_joint_set: MultibodyJointSet
        - ccd_solver: CCDSolver
        - physics_hooks: ()
        - event_handler: ()
        + new() -> PhysicsSpace
    }

    interface DynamicObject << (T,ORANGE) >> {
        + teleport(&mut self, ctx: &mut PhysicsContext, vec: Vec2)
    }

    interface Entity << (T,ORANGE) >> {
        + rigid_body<'a>(&self, ctx: &'a mut PhysicsContext) -> &'a mut RigidBody
        + rb_handle(&self) -> RigidBodyHandle
    }
}

package "Draw" {
    struct "Children<D: DrawableComponent>" as Children {
        + drawables: Vec<D>
        + new() -> Children<D>
        + add_drawable(&mut self, item: D)
    }

    struct Drawable {
        - transform: Transform
        - color: Rgba8
        ~ cache: Arc<Cache>
        ~ render: DrawableRenderContext
        + new(...) -> Drawable
        + new_with_color(...) -> Drawable
        + from_shape(shape: Shapes, drw: DrawableCreateInfo) -> Drawable
    }

    struct PhysicsDrawable {
        - rb_h: RigidBodyHandle
        - drawable: Drawable
        + new(rb_h: RigidBodyHandle, drawable: Drawable) -> PhysicsDrawable
        + get_rb(...) -> &mut RigidBody
        + get_rb_handle(&self) -> RigidBodyHandle
        + get_drawable(&self) -> &Drawable
        + get_mut_drawable(&mut self) -> &mut Drawable
    }

    struct DrawableRenderContext {
        ~ descriptor_id: DescriptorID
        - pipeline_id: PipelineID
        - mesh: Mesh
    }

    struct PipelineID {
        + id: String
    }

    struct DescriptorID {
        + id: String
    }

    struct Mesh {
        - vertex: Vec<MyVertex>
        - id: u32
        + new(...) -> Mesh
        + get_id(&self) -> &u32
    }

    struct Transform {
        + transform: [[f32; 4]; 4]
    }

    interface Position << (T,ORANGE) >> {
        + get_matrix_mut(&mut self) -> &mut [[f32; 4]; 4]
        + get_matrix(&self) -> &[[f32; 4]; 4]
    }

    struct DrawableCreateInfo {
        + cache: Option<Arc<Cache>>
        + position: Vec2
        + texture: Option<Texture>
        + radius: f32
        + thickness: f32
        + size: Vec2
        + id: u32
        + color: Rgba8
    }

    enum Shapes {
        Square
        Circle
        Image(Texture)
        + get_vertex_and_descriptor(&self, cache: &Arc<Cache>) -> (Vec<MyVertex>, Option<Arc<DescriptorSet>>)
    }

    struct Texture {
        ~ image: Vec<u8>
        + dimensions: (u32, u32)
        + from_file(path: &str) -> Option<Texture>
        + from_internal_assets(filename: &str) -> Option<Texture>
    }

    interface DrawableGPU << (T,ORANGE) >> {
        + set_vertex(&mut self, vertex: Vec<MyVertex>)
        + get_vertex_clone(&self) -> Vec<MyVertex>
        + get_vertex(&self) -> &Vec<MyVertex>
        + get_colour(&self) -> &Rgba8
        + get_pipeline(&self) -> Arc<GraphicsPipeline>
    }

    interface DrawableComponent << (T,ORANGE) >> {
        + get_transform(&self) -> &Transform
        + get_transform_clone(&self) -> Transform
        + set_transform(&mut self, transform: Transform)
        + drawable(&self) -> &Drawable
        + drawable_mut(&mut self) -> &mut Drawable
    }
}

' Relationships
ApplicationHandler <|.. EngineContext : implement
PipelineHandle <|.. Cache : implement
DescriptorHandle <|.. Cache : implement

EngineContext o-- RenderContext : contains (Option)
EngineContext *-- EngineMemory : own
EngineContext *-- Cache : own
EngineContext *-- PhysicsContext : own
EngineContext *-- Children : own
PhysicsContext *-- PhysicsSpace : own

DrawableGPU <|-- DrawableComponent : extend
DrawableComponent <|.. Drawable : implement
DrawableGPU <|.. Drawable : implement
DrawableComponent <|.. PhysicsDrawable : implement
DrawableGPU <|.. PhysicsDrawable : implement

DynamicObject <|.. PhysicsDrawable : implement
Entity <|.. PhysicsDrawable : implement
Entity --|> DrawableComponent : extend
Entity --|> DynamicObject : extend

Position <|.. Transform : implement

Children o-- DrawableComponent : contains

Drawable *-- Transform : own
Drawable *-- DrawableRenderContext : own
DrawableRenderContext *-- Mesh : own
DrawableRenderContext *-- PipelineID : own
DrawableRenderContext *-- DescriptorID : own
Mesh *-- MyVertex : own

PhysicsDrawable *-- Drawable : own
Shapes o-- Texture : contains

note right of EngineContext
    Центральная точка входа.
    Управляет жизненным циклом
    приложения через ApplicationHandler.
    Настраивается через замыкания
    (Start и Redraw).
end note

@enduml